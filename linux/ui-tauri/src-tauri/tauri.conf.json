{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vortex",
  "version": "1.0.0-beta.7",
  "identifier": "uz.vortex.linux",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5172"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vortex",
        "width": 920,
        "height": 860,
        "minWidth": 560,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-ancestors 'none'; base-uri 'self'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.cache/vortex/clipboard/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "depends": [
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free",
          "pulseaudio-utils",
          "NetworkManager",
          "bluez",
          "zenity",
          "nautilus-python"
        ],
        "files": {
          "/usr/share/nautilus-python/extensions/vortex.py": "../../packaging/nautilus/vortex.py",
          "/usr/share/gnome-shell/extensions/vortex-live@vortex/metadata.json": "../../gnome-extension/vortex-live@vortex/metadata.json",
          "/usr/share/gnome-shell/extensions/vortex-live@vortex/extension.js": "../../gnome-extension/vortex-live@vortex/extension.js",
          "/usr/share/gnome-shell/extensions/vortex-live@vortex/stylesheet.css": "../../gnome-extension/vortex-live@vortex/stylesheet.css"
        }
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "pulseaudio-utils",
          "network-manager",
          "bluez",
          "zenity",
          "python3-nautilus"
        ],
        "files": {
          "/usr/share/nautilus-python/extensions/vortex.py": "../../packaging/nautilus/vortex.py",
          "/usr/share/gnome-shell/extensions/vortex-live@vortex/metadata.json": "../../gnome-extension/vortex-live@vortex/metadata.json",
          "/usr/share/gnome-shell/extensions/vortex-live@vortex/extension.js": "../../gnome-extension/vortex-live@vortex/extension.js",
          "/usr/share/gnome-shell/extensions/vortex-live@vortex/stylesheet.css": "../../gnome-extension/vortex-live@vortex/stylesheet.css"
        }
      }
    }
  }
}
